# Pixel AI Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Admin
ADMIN_SECRET=change-this-to-a-strong-random-secret

# Remove.bg (background removal)
# Get your key at https://www.remove.bg/api
REMOVEBG_API_KEY=

# fal.ai (AI image generation)
# Get your key at https://fal.ai/dashboard
FAL_API_KEY=

# Replicate (alternative AI provider)
# Get your token at https://replicate.com/account
REPLICATE_API_TOKEN=

# Cloudinary (photo storage)
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (SMS + WhatsApp delivery)
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# WhatsApp sender (sandbox: whatsapp:+14155238886, production: your approved number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
