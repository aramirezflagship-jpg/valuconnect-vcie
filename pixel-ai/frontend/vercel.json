{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://flash-it-backend-akf5.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://flash-it-backend-akf5.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
