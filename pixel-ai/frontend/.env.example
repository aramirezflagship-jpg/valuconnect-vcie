# Flash-it Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# All VITE_ variables are embedded at build time and are public — never put secrets here.

# Backend API URL
# Development: http://localhost:3000
# Production: your Railway backend URL (e.g. https://flash-it-backend.up.railway.app)
VITE_API_URL=http://localhost:3000

# Supabase (optional — only needed if backend is using Supabase Auth)
# These are the public/anon values — safe to expose in the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push — must match VAPID_PUBLIC_KEY set on the backend
VITE_VAPID_PUBLIC_KEY=

# Demo mode — set to true to show demo UI hints in development
VITE_DEMO_MODE=false
