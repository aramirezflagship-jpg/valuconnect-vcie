# ValuConnect VCIE — Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to Git

# Google Gemini API — FREE tier at aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# YouTube Data API v3 (console.cloud.google.com → Enable YouTube Data API v3)
YOUTUBE_API_KEY=AIza...

# Reddit API (reddit.com/prefs/apps → Create script app)
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=ValuConnect-VCIE/1.0

# Google Calendar API (optional — console.cloud.google.com → Enable Calendar API → OAuth 2.0)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./config/google-credentials.json

# Notifications (optional)
SENDGRID_API_KEY=SG....
NOTIFY_EMAIL=andres@valuconnect.com
SLACK_WEBHOOK_URL=

# Pipeline settings
OUTPUT_DIR=./outputs
LOG_FILE=./logs/run-history.jsonl
OUTLIER_THRESHOLD=300
RELEVANCE_THRESHOLD=60
MAX_TOPICS_PER_RUN=5

# ── ValuConnect CRM (leak engine) ──
# Where prospects go: crawler, intake form and brief generator all POST to
# {LEAK_ENGINE_URL}/api/sales/import. Must match the engine's INTERNAL_API_TOKEN.
# Monday.com vars below are only a fallback until this is live, plus client delivery.
LEAK_ENGINE_URL=https://crm.vcsolutions.us
INTERNAL_API_TOKEN=same-long-random-string-as-the-engine
