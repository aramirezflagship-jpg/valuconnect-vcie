# Flash-it Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Variables marked REQUIRED must be set before the server will start correctly.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Admin ─────────────────────────────────────────────────────────────────────
# REQUIRED — password for the /admin panel
ADMIN_SECRET=change-me-to-something-secret

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — used to sign customer JWT tokens
JWT_SECRET=change-me-to-a-random-string-32-chars-minimum

# ── Supabase (optional) ───────────────────────────────────────────────────────
# When these are NOT set, the app uses a local JSON store (config/users.json).
# Set these for production — local mode is for development only.
# Get values from: Supabase dashboard → your project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# Get from: Stripe → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Twilio (SMS + WhatsApp delivery) ──────────────────────────────────────────
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# WhatsApp sender: use sandbox number below for testing,
# replace with your approved Twilio number for production
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Cloudflare R2 (photo storage) ─────────────────────────────────────────────
# Account ID: Cloudflare dashboard → Workers & Pages → Overview (right sidebar)
R2_ACCOUNT_ID=
# API token: Cloudflare → R2 → Manage R2 API tokens → Create token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flash-it-photos
# Optional: public URL for the bucket (Cloudflare → R2 → your bucket → Settings → Public access)
# e.g. https://pub-abc123.r2.dev  or  https://photos.yourdomain.com
# If left empty, 24-hour presigned URLs are used instead.
R2_PUBLIC_URL=

# ── fal.ai (background removal + FLUX image generation) ───────────────────────
# REQUIRED — get your key at https://fal.ai/dashboard
FAL_API_KEY=

# ── Replicate (alternative AI provider, optional) ────────────────────────────
REPLICATE_API_TOKEN=

# ── SendGrid (invoice + receipt emails) ──────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# Verified sender identity in SendGrid
SENDGRID_FROM_EMAIL=hello@flash-it.app

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@flash-it.app

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# In production: set this to your Vercel domain (e.g. https://flash-it.vercel.app)
FRONTEND_URL=http://localhost:3001
